{
  "name": "ds-copilot-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone browser UI for the DS co-pilot: read-only projection of on-disk state (spec §10). One package, three areas: client (Vite+React), server (Fastify+chokidar+SSE), shared (TS types).",
  "type": "module",
  "scripts": {
    "test": "vitest run --passWithNoTests && vitest run --config hooks/vitest.config.ts",
    "test:watch": "vitest",
    "test:hooks": "vitest run --config hooks/vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "tsc -p client/tsconfig.json --noEmit && vite build",
    "start": "npm run build && npm run server",
    "preview": "vite preview",
    "catchup": "tsx hooks/session-catchup.ts",
    "server": "tsx server/main.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.4.0",
    "chokidar": "^4.0.3",
    "elkjs": "^0.9.3",
    "fastify": "^5.2.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "plotly.js-dist-min": "^2.35.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-plotly.js": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
